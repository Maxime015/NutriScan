# URL et clé anonyme du projet Supabase (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL de l'API Flask.
# En développement sur un appareil physique : utilisez l'adresse IP locale de votre machine (pas localhost).
# Exemple : http://192.168.1.20:5050
# Simulateur iOS : http://localhost:5050
# (Le port 5050 est utilisé car le port 5000 peut être occupé par AirPlay sur macOS.)
EXPO_PUBLIC_API_URL=http://localhost:5050