# ==============================
# Backend - Variables d'environnement
# ==============================

# Clé API OCR.space (utilisée dans app.py pour l'OCR des étiquettes)
OCR_API_KEY=your_ocr_api_key

# Vérification des tokens Supabase (app.py)
# Pour les projets Supabase récents (signature asymétrique ES256) :
# Format : https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Clé API Google Gemini (utilisée dans utils.py)
GEMINI_API_KEY=your_gemini_api_key